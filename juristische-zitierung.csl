<?xml version="1.0" encoding="utf-8"?>
<style class="note" default-locale="de-DE" delimiter-precedes-et-al="never" delimiter-precedes-last="never" demote-non-dropping-particle="never" et-al-min="11" et-al-use-first="10" initialize="false" page-range-format="expanded" version="1.0" xmlns="http://purl.org/net/xbiblio/csl">
  <info>
    <title>Juristische Zitierung mit PID</title>
    <id>http://www.zotero.org/styles/juristische-zitierung</id>
    <link href="http://www.zotero.org/styles/juristische-zitierung" rel="self"></link>
    <link href="http://www.zotero.org/styles/mohr-siebeck-recht" rel="template"></link>
    <author>
      <name>Constantin Breß</name>
      <email>constantin.bress@partner.kit.edu</email>
      <uri>https://orcid.org/0000-0002-2133-1541</uri>
    </author>
    <category citation-format="note"></category>
    <category field="law"></category>
    <summary>Kommentare sind als "entry-encyclopedia" zu kategorisieren, um richtig zitiert werden zu können. Zitierstil basiert auf Mohr Siebeck - Recht (Deutsch - Österreich) und erweitert diesen um verschiedene Arten von IDs wie der ECLI bei Urteilen oder die ISBN bei Monographien.</summary>
    <updated>2021-11-13T18:15:14+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <macro name="author-article-journal">
    <names font-style="italic" variable="author">
      <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="5" form="short" initialize="false"></name>
      <et-al font-style="italic"></et-al>
    </names>
  </macro>
  <macro name="author-book">
    <names font-style="italic" variable="author">
      <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="5" form="short" initialize="false"></name>
      <et-al></et-al>
    </names>
    <text form="short" prefix=", " suffix=" " variable="title"></text>
  </macro>
  <macro name="author-chapter">
    <names font-style="italic" variable="author">
      <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="6" et-al-use-first="5" font-style="italic" form="short" initialize="false"></name>
      <et-al font-style="italic"></et-al>
    </names>
  </macro>
  <macro name="author-article-newspaper">
    <names font-style="normal" variable="author">
      <name delimiter="/ " delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="20" et-al-use-first="19" form="short" initialize="false"></name>
    </names>
  </macro>
  <macro name="authority">
    <names variable="author">
      <name delimiter=" " initialize="false"></name>
    </names>
  </macro>
  <macro name="author-note">
    <names font-style="italic" variable="author">
      <name delimiter="/" et-al-min="3" et-al-use-first="1" font-style="italic" form="short" name-as-sort-order="all"></name>
    </names>
  </macro>
  <macro name="editor-note">
    <names suffix=" (Hrsg.), " variable="editor">
      <name delimiter="/" et-al-min="3" et-al-use-first="1" font-style="italic" form="short" name-as-sort-order="all"></name>
    </names>
  </macro>
  <macro name="locator-with-label">
    <group delimiter=" ">
      <label form="symbol" variable="locator"></label>
      <text variable="locator"></text>
    </group>
  </macro>
  <macro name="custom-sort">
    <choose>
      <if type="entry-encyclopedia">
        <names variable="editor"></names>
      </if>
      <else>
        <text macro="author"></text>
      </else>
    </choose>
  </macro>
  <macro name="firstpage-locator">
    <group delimiter=" ">
      <text variable="page-first"></text>
      <text prefix="(" suffix=")" variable="locator"></text>
    </group>
  </macro>
  <macro name="author">
    <names font-style="italic" variable="author">
      <name delimiter="/" font-style="italic" name-as-sort-order="all"></name>
      <label form="short" prefix=" (" suffix=")"></label>
      <substitute>
        <names variable="editor"></names>
      </substitute>
    </names>
  </macro>
  <macro name="pid">
    <choose>
      <if match="all" variable="isbn">
        <text font-variant="small-caps" suffix=": " value="ISBN"></text>
        <text variable="isbn"></text>
      </if>
      <else-if match="all" variable="number">
        <text font-variant="small-caps" suffix=": " value="arxiv"></text>
        <text variable="number"></text>
      </else-if>
      <else-if match="all" variable="doi">
        <text font-variant="small-caps" suffix=": " value="DOI"></text>
        <text variable="doi"></text>
      </else-if>
      <else-if match="all" variable="url">
        <text font-variant="small-caps" suffix=": " value="URL"></text>
        <text variable="url"></text>
      </else-if>
    </choose>
  </macro>
  <citation>
    <layout delimiter="; " suffix=".">
      <group delimiter=", ">
        <group>
          <choose>
            <if match="all" type="article-journal">
              <text macro="author-article-journal"></text>
              <text form="short" prefix=", " suffix=" " variable="container-title"></text>
              <group delimiter=" ">
                <choose>
                  <if match="all" variable="issued">
                    <date date-parts="year" form="text" suffix="," variable="issued"></date>
                  </if>
                </choose>
                <text variable="page-first"></text>
                <text prefix=", " variable="locator"></text>
              </group>
            </if>
            <else-if match="all" type="book">
              <text macro="author-book"></text>
              <date date-parts="year" form="text" prefix="(" suffix=")" variable="issued"></date>
              <choose>
                <if match="all" variable="edition">
                  <text variable="edition" vertical-align="sup"></text>
                </if>
              </choose>
              <group delimiter=" " prefix=", ">
                <label form="symbol" variable="locator"></label>
                <text variable="locator"></text>
              </group>
            </else-if>
            <else-if match="all" type="chapter">
              <text macro="author-note" suffix=", "></text>
              <text suffix=", " variable="title"></text>
              <text prefix=", " value="in: "></text>
              <choose>
                <if match="all" variable="editor">
                  <text macro="editor-note"></text>
                </if>
              </choose>
              <text form="short" variable="container-title"></text>
              <date date-parts="year" form="text" prefix=" (" suffix=")" variable="issued"></date>
              <choose>
                <if match="any" variable="edition">
                  <text form="short" variable="edition" vertical-align="sup"></text>
                </if>
              </choose>
              <group prefix=", ">
                <text variable="page-first"></text>
                <text prefix=", " variable="locator"></text>
              </group>
            </else-if>
            <else-if match="any" type="webpage">
              <text form="short" suffix=", " variable="title"></text>
              <text prefix="&lt;" suffix=">     , " variable="URL"></text>
              <date form="numeric" prefix="Stand " variable="accessed"></date>
            </else-if>
            <else-if match="any" type="article-newspaper">
              <text macro="author-article-newspaper" suffix=", "></text>
              <text suffix=", " variable="title"></text>
              <text suffix=" " variable="publisher"></text>
              <date form="numeric" prefix="vom " suffix=", " variable="issued"></date>
              <choose>
                <if match="any" variable="issue">
                  <text prefix="Nr. " variable="issue"></text>
                </if>
              </choose>
            </else-if>
            <else-if match="any" type="legal_case">
              <group>
                <choose>
                  <if match="any" variable="volume">
                    <text form="short" variable="authority"></text>
                    <group delimiter=" ">
                      <text suffix=", " variable="container-title"></text>
                      <text variable="volume"></text>
                    </group>
                  </if>
                  <else-if match="any" variable="number">
                    <text form="short" suffix="," variable="authority"></text>
                    <group delimiter=" " prefix=" ">
                      <text variable="genre"></text>
                      <date form="text" prefix="v. " variable="issued"></date>
                      <group prefix="(" suffix=")">
                        <text variable="number"></text>
                        <choose>
                          <if match="any" variable="ecli">
                            <text prefix=", " variable="ecli"></text>
                          </if>
                        </choose>
                      </group>
                    </group>
                    <group delimiter=" ">
                      <text variable="container-title"></text>
                    </group>
                  </else-if>
                  <else>
                    <group delimiter=",">
                      <text variable="container-title"></text>
                      <text prefix=" " variable="volume"></text>
                    </group>
                  </else>
                </choose>
                <text macro="firstpage-locator"></text>
                <text prefix=" – " suffix=" - " variable="title-short"></text>
              </group>
            </else-if>
            <else>
              <text macro="author-note"></text>
              <text form="short" prefix=", " suffix=" " variable="title"></text>
              <date date-parts="year" form="text" prefix="(" suffix=")" variable="issued"></date>
              <choose>
                <if match="any" variable="edition">
                  <text form="short" variable="edition" vertical-align="sup"></text>
                </if>
              </choose>
            </else>
          </choose>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography entry-spacing="1" hanging-indent="true" page-range-format="expanded" subsequent-author-substitute="–">
    <sort>
      <key macro="custom-sort"></key>
      <key variable="issued"></key>
      <key names-use-first="1" variable="author"></key>
    </sort>
    <layout>
      <choose>
        <if match="any" type="article-journal">
          <names font-style="italic" variable="author">
            <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6" font-style="italic" initialize="false" name-as-sort-order="all"></name>
          </names>
          <text prefix=": " suffix=", " variable="title"></text>
          <text suffix=", " variable="collection-title"></text>
          <text suffix=" " variable="container-title"></text>
          <date date-parts="year" form="text" suffix=", " variable="issued"></date>
          <text suffix="." variable="page"></text>
          <text macro="pid" prefix=" "></text>
        </if>
        <else-if match="all" type="book">
          <group suffix=".">
            <names variable="author">
              <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6" font-style="italic" initialize="false" name-as-sort-order="all"></name>
            </names>
            <text prefix=": " variable="title"></text>
            <choose>
              <if match="any" variable="collection-title">
                <group prefix=" (" suffix=") ">
                  <text variable="collection-title"></text>
                  <text prefix=" " variable="collection-number"></text>
                </group>
              </if>
            </choose>
            <choose>
              <if match="any" variable="edition">
                <text suffix=". " variable="edition"></text>
                <text form="short" suffix=" " term="edition"></text>
              </if>
            </choose>
            <group prefix=". ">
              <text suffix=" " variable="publisher-place"></text>
              <date date-parts="year" form="text" suffix="." variable="issued"></date>
            </group>
            <text macro="pid" prefix=" "></text>
          </group>
        </else-if>
        <else-if match="any" type="chapter">
          <names font-style="italic" variable="author">
            <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6" font-style="italic" initialize="false" name-as-sort-order="all"></name>
          </names>
          <text prefix=": " suffix=", " variable="title"></text>
          <choose>
            <if match="all" variable="editor">
              <names delimiter="/" font-variant="normal" prefix="in: " suffix=" (Hrsg.): " variable="editor">
                <name delimiter="/" delimiter-precedes-et-al="never" delimiter-precedes-last="never" et-al-min="7" et-al-use-first="6" form="short" name-as-sort-order="all"></name>
              </names>
              <text suffix=", " variable="container-title"></text>
            </if>
          </choose>
          <choose>
            <if match="any" variable="edition">
              <text suffix=". " variable="edition"></text>
              <text form="short" suffix=" " term="edition"></text>
            </if>
          </choose>
          <text suffix=" " variable="publisher-place"></text>
          <date date-parts="year" form="text" suffix=", " variable="issued"></date>
          <text suffix="." variable="page"></text>
          <text macro="pid" prefix=" "></text>
        </else-if>
        <else-if match="any" type="paper-conference">
          <group>
            <text macro="author"></text>
            <text prefix=": " suffix=", " variable="title"></text>
          </group>
          <text prefix="in: " suffix=" (Hrsg.): " variable="publisher"></text>
          <text suffix=", " variable="container-title"></text>
          <text suffix=" " variable="publisher-place"></text>
          <date date-parts="year" form="text" suffix=", " variable="issued"></date>
          <text suffix="." variable="page"></text>
          <text macro="pid" prefix=" "></text>
        </else-if>
        <else-if match="all" type="article">
          <group delimiter=", " suffix=".">
            <text macro="author"></text>
            <text variable="title"></text>
            <text macro="locator-with-label"></text>
          </group>
          <text macro="pid" prefix=" "></text>
        </else-if>
        <else-if match="all" type="document">
          <group delimiter=", " suffix=".">
            <text macro="author"></text>
            <text variable="title"></text>
            <text macro="locator-with-label"></text>
          </group>
          <text macro="pid" prefix=" "></text>
        </else-if>
      </choose>
    </layout>
  </bibliography>
</style>
